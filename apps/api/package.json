    "@remotfix/telemetry": "workspace:*",
    "@remotfix/types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@remotfix/config": "workspace:*",
    "@types/express": "^5.0.0",
