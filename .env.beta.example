# ==============================================================================
# REMOTFIX — MVP Beta Environment Configuration Template (ADR-0051)
# ==============================================================================
# Environment Classification: TEST / STAGING (Beta Feedback)
# Target Infrastructure Cost: ₹0 / $0
#
# APPROVED BETA STACK:
# - Vercel Hobby  -> Next.js Web
# - Render Free   -> NestJS API (Docker Web Service)
# - Neon Free     -> Serverless PostgreSQL 16 (0.5 GB Storage)
# - Upstash Free  -> Serverless Redis 7 (10,000 commands/day)
#
# UPGRADE TRIGGER:
# First genuine paying client -> Migrate to paid MVP Production infrastructure.
#
# IMPORTANT:
# DO NOT COMMIT REAL SECRETS TO GIT.
# This file is a documentation template. Set these values in provider dashboards.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RENDER WEB SERVICE — NestJS API Environment Variables
# ------------------------------------------------------------------------------
# Set in Render Dashboard -> Service Settings -> Environment Variables
# (or managed automatically via render.yaml blueprint)

# Runtime Environment
NODE_ENV=production
PORT=4000

# CORS Allowed Origin: The exact Vercel frontend URL (without trailing slash)
CORS_ORIGIN=https://remotfix-beta.vercel.app

# PostgreSQL Datastore (Neon Free Tier)
# NOTE ON PRISMA: schema.prisma exclusively reads DATABASE_URL.
# - For Render API Runtime: Set DATABASE_URL to Neon's POOLED connection string (PgBouncer).
#   Format: postgresql://[user]:[password]@[neon-host]-pooler.[region].neon.tech/[dbname]?sslmode=require
# - For Prisma Migrations (Local/CI): Temporarily pass Neon's DIRECT connection string as DATABASE_URL:
#   DATABASE_URL="postgresql://[user]:[password]@[neon-host].[region].neon.tech/[dbname]?sslmode=require" pnpm --filter=@remotfix/database exec prisma migrate deploy
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct PostgreSQL URL (Documentation convenience only; not consumed automatically by Prisma schema)
# Format: postgresql://[user]:[password]@[neon-host].[region].neon.tech/[dbname]?sslmode=require
DIRECT_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Queue & Distributed Token Bucket (Upstash Free Tier)
# Use the TLS connection string ('rediss://' protocol with double 's')
# Format: rediss://default:[password]@[endpoint].upstash.io:[port]
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@sample-endpoint.upstash.io:6379

# Cryptographic Secrets (Must be high-entropy, >= 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET=generate_min_32_char_random_secret_hex_here
APP_SECRET=generate_min_32_char_random_secret_hex_here
MFA_ENCRYPTION_KEY=generate_min_32_char_random_secret_hex_here
ADMIN_KEY=generate_min_32_char_random_secret_hex_here

# ------------------------------------------------------------------------------
# 2. VERCEL HOBBY — Next.js Web Frontend Environment Variables
# ------------------------------------------------------------------------------
# Set in Vercel Dashboard -> Project Settings -> Environment Variables
#
# POLICY BOUNDARY:
# Vercel Hobby is used ONLY for the approved non-commercial MVP Beta / stakeholder
# testing / feedback phase. No customer payments, commercial revenue, or paid
# service operation may occur while using Vercel Hobby.
# FIRST GENUINE PAYING CLIENT = mandatory transition to the paid production
# environment, including the appropriate Vercel paid tier (Pro).

# Base API URL: The Render backend service origin (without trailing slash, NO '/api/v1')
# Code automatically appends /api/v1/[endpoint]
NEXT_PUBLIC_API_URL=https://remotfix-api.onrender.com
